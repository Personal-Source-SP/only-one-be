{
    "name": "only-one-be",
    "private": true,
    "version": "0.0.1",
    "description": "",
    "author": "Only One",
    "license": "UNLICENSED",
    "scripts": {
        "clean": "rimraf dist",
        "clean:swc": "rimraf dist-swc",
        "copy-assets": "node copy-assets.js",
        "postinstall": "husky install",
        "build": "rimraf dist && tsc -p tsconfig.build.json && nest build",
        "build:swc": "npm run clean:swc && swc src -d dist-swc --copy-files",
        "build:typecheck:swc": "npm run typecheck && npm run build:swc",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "prettier:write": "prettier --write .",
        "migration:generate": "cross-var npm run typeorm -- migration:generate ./src/migrations/$npm_config_name",
        "migration:revert": "npm run typeorm -- migration:revert",
        "migration:create": "cross-var ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli migration:create ./src/migrations/$npm_config_name",
        "migration:run": "npm run typeorm -- migration:run",
        "schema:drop": "ts-node node_modules/typeorm/cli.js schema:drop -f ormconfig",
        "start": "ts-node -r tsconfig-paths/register src/main.ts",
        "dev": "npm run start:dev",
        "start:dev": "nest start --watch",
        "start:dev:swc": "nest start -b swc --type-check --watch",
        "start:debug": "nest start --watch --debug",
        "start:debug:swc": "nest start -b swc --watch --debug",
        "start:prod": "node dist/src/main.js",
        "lint": "eslint \"{src,test}/**/*.ts\"",
        "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
        "test": "jest  --runInBand --detectOpenHandles --forceExit",
        "test:silent": "jest --silent --runInBand --detectOpenHandles --forceExit --reporters=default --reporters=jest-junit",
        "test:watch": "jest --watch",
        "test:cov": "jest --collectCoverage  --runInBand --detectOpenHandles --forceExit",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config jest-e2e.json",
        "seed": "ts-node -r tsconfig-paths/register src/modules/seeder/seed.ts",
        "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli -d ormconfig.ts",
        "typecheck": "tsc"
    },
    "dependencies": {
        "@automapper/classes": "^8.8.1",
        "@automapper/core": "^8.8.1",
        "@automapper/nestjs": "^8.8.1",
        "@nestjs/axios": "^3.1.1",
        "@nestjs/bull": "^10.2.2",
        "@nestjs/cli": "^10.4.5",
        "@nestjs/common": "^10.4.6",
        "@nestjs/config": "^3.3.0",
        "@nestjs/core": "^10.4.6",
        "@nestjs/event-emitter": "^2.1.1",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.4.6",
        "@nestjs/schedule": "^4.1.1",
        "@nestjs/swagger": "^7.4.2",
        "@nestjs/terminus": "^10.2.3",
        "@nestjs/typeorm": "^10.0.2",
        "axios": "^1.7.7",
        "bcrypt": "^5.1.1",
        "bcryptjs": "^2.4.3",
        "bull": "^4.16.4",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "cz-conventional-changelog": "^3.3.0",
        "dotenv": "^16.4.5",
        "express-rate-limit": "^7.4.1",
        "helmet": "^8.0.0",
        "ioredis": "^5.4.1",
        "jest": "^29.7.0",
        "lint-staged": "^15.2.10",
        "lodash": "^4.17.21",
        "module-alias": "^2.2.3",
        "morgan": "^1.10.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.13.1",
        "pg-query-stream": "^4.7.1",
        "reflect-metadata": "~0.1.13",
        "rimraf": "^6.0.1",
        "rxjs": "^7.8.1",
        "slugify": "^1.6.6",
        "source-map-support": "^0.5.21",
        "typeorm": "^0.3.20",
        "winston": "^3.2.1",
        "winston-daily-rotate-file": "^3.10.0"
    },
    "devDependencies": {
        "@swc/cli": "^0.4.0",
        "@swc/core": "^1.7.42",
        "@types/bcrypt": "^5.0.2",
        "@types/eslint": "^9.6.1",
        "@types/express": "^5.0.0",
        "@types/lodash": "^4.17.13",
        "@types/morgan": "^1.9.9",
        "@types/node": "^22.8.6",
        "@types/passport-jwt": "^4.0.1",
        "@typescript-eslint/eslint-plugin": "^8.12.2",
        "@typescript-eslint/parser": "^8.12.2",
        "cross-var": "^1.1.0",
        "eslint": "8.57.1",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-typescript": "^3.6.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "husky": "7.0.4",
        "prettier": "^3.3.3",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "testRegex": ".spec.ts$",
        "preset": "ts-jest",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "src/modules/**/*.(t|j)s"
        ],
        "coverageDirectory": "./coverage",
        "testEnvironment": "node",
        "globalSetup": "./jest.setup.ts",
        "testTimeout": 30000
    },
    "lint-staged": {
        "*.@(ts)": [
            "eslint --fix"
        ]
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog",
            "prepare-commit-msg": "exec < /dev/tty && git cz --hook || true"
        }
    },
    "keywords": [
        "nestjs",
        "boilerpale",
        "microservice",
        "ddd",
        "cqrs",
        "eventsourcing",
        "eventstore"
    ],
    "_moduleAliases": {
        "@": "dist/src"
    }
}
