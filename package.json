{
    "name": "only-one-be",
    "private": true,
    "version": "0.0.1",
    "description": "",
    "author": "Only One",
    "license": "UNLICENSED",
    "scripts": {
        "clean": "rimraf dist",
        "clean:swc": "rimraf dist-swc",
        "copy-assets": "node copy-assets.js",
        "postinstall": "husky install",
        "build": "rimraf dist && tsc -p tsconfig.build.json && nest build",
        "build:swc": "npm run clean:swc && swc src -d dist-swc --copy-files",
        "build:typecheck:swc": "npm run typecheck && npm run build:swc",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "prettier:write": "prettier --write .",
        "migration:generate": "cross-var npm run typeorm -- migration:generate ./src/migrations/$npm_config_name",
        "migration:revert": "npm run typeorm -- migration:revert",
        "migration:create": "cross-var ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli migration:create ./src/migrations/$npm_config_name",
        "migration:run": "npm run typeorm -- migration:run",
        "schema:drop": "ts-node node_modules/typeorm/cli.js schema:drop -f ormconfig",
        "start": "ts-node -r tsconfig-paths/register src/main.ts",
        "dev": "npm run start:dev",
        "start:dev": "nest start --watch",
        "start:dev:swc": "nest start -b swc --type-check --watch",
        "start:debug": "nest start --watch --debug",
        "start:debug:swc": "nest start -b swc --watch --debug",
        "start:prod": "node dist/src/main.js",
        "lint": "eslint \"{src,test}/**/*.ts\"",
        "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
        "seed": "ts-node -r tsconfig-paths/register src/modules/seeder/seed.ts",
        "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli -d ormconfig.ts"
    },
    "dependencies": {
        "@automapper/classes": "^8.8.1",
        "@automapper/core": "^8.8.1",
        "@automapper/nestjs": "^8.8.1",
        "@nestjs/axios": "^4.0.1",
        "@nestjs/cli": "^11.0.10",
        "@nestjs/common": "^11.1.5 ",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.5",
        "@nestjs/event-emitter": "^3.0.1",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.5",
        "@nestjs/swagger": "^11.2.0",
        "@nestjs/terminus": "^11.0.0",
        "@nestjs/typeorm": "^11.0.0",
        "axios": "^1.7.7",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "cz-conventional-changelog": "^3.3.0",
        "dotenv": "^17.2.1",
        "express-rate-limit": "^8.0.1",
        "helmet": "^8.0.0",
        "ioredis": "^5.4.1",
        "lint-staged": "^16.1.2",
        "lodash": "^4.17.21",
        "morgan": "^1.10.0",
        "nestjs-paginate": "^12.5.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.13.1",
        "pg-query-stream": "^4.7.1",
        "puppeteer": "^24.17.0",
        "reflect-metadata": "~0.2.2",
        "rimraf": "^6.0.1",
        "rxjs": "^7.8.1",
        "slugify": "^1.6.6",
        "source-map-support": "^0.5.21",
        "typeorm": "^0.3.20",
        "uuid": "^11.1.0",
        "winston": "^3.2.1",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@swc/cli": "^0.7.8",
        "@swc/core": "^1.7.42",
        "@types/bcrypt": "^6.0.0",
        "@types/eslint": "^9.6.1",
        "@types/express": "^5.0.0",
        "@types/lodash": "^4.17.13",
        "@types/morgan": "^1.9.9",
        "@types/node": "^24.1.0",
        "@types/passport-jwt": "^4.0.1",
        "@typescript-eslint/eslint-plugin": "^8.12.2",
        "@typescript-eslint/parser": "^8.12.2",
        "cross-var": "^1.1.0",
        "eslint": "9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "husky": "9.1.7",
        "prettier": "^3.3.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.3"
    },
    "overrides": {
        "@automapper/classes": {
            "reflect-metadata": "^0.2.2"
        },
        "@automapper/nestjs": {
            "@nestjs/common": "^11.0.0",
            "@nestjs/core": "^11.0.0"
        }
    },
    "lint-staged": {
        "*.@(ts)": [
            "eslint --fix"
        ]
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog",
            "prepare-commit-msg": "exec < /dev/tty && git cz --hook || true"
        }
    },
    "keywords": [
        "nestjs",
        "boilerpale",
        "microservice",
        "ddd",
        "cqrs",
        "eventsourcing",
        "eventstore"
    ]
}
